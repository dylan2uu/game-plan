{
  "manifest_version": 3,
  "name": "Game Plan Focus",
  "version": "3.1.0",
  "description": "Game Plan's helper: blocks distractions during a timer, locks streaming sites 10:30pm-7am behind a typed sentence, and checks Brightspace so anything you submitted there is marked done in Game Plan.",
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Game Plan Focus",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "192": "icon-192.png"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
